# Copy to .env and fill in. .env is gitignored; this example is committed.
#
# These are read at CLI startup (python-dotenv). Existing environment
# variables always take precedence. CLI flags like --api-key / --api-base
# override both.

# --- Anthropic provider (--provider anthropic) ---
# Direct Anthropic API:
# ANTHROPIC_API_KEY=sk-ant-...
#
# Custom endpoint (LiteLLM proxy, local server, etc.):
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_BASE_URL=http://localhost:8080

# --- LiteLLM provider (--provider litellm) ---
# LiteLLM reads provider-specific env vars based on the --model prefix.
# Example for OpenAI-compatible local endpoint:
# OPENAI_API_KEY=sk-...
# Then run with: --provider litellm --model openai/<name> --api-base http://localhost:8000/v1

# --- Proxy (if your endpoint requires one) ---
# HTTPS_PROXY=http://user:pass@host:port
# HTTP_PROXY=http://user:pass@host:port
# NO_PROXY=localhost,127.0.0.1
