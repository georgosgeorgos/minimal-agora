# Copy to .env and fill in. .env is gitignored; this example is committed.
#
# These are read at CLI startup (python-dotenv). Existing environment
# variables always take precedence over values here. CLI flags like
# --api-key / --api-base override both.

# --- Anthropic provider (--provider anthropic) ---
# Used by AnthropicAPIProvider via the official SDK.
ANTHROPIC_API_KEY=sk-ant-...
# Point at a local/Anthropic-compatible proxy instead of the real API:
# ANTHROPIC_BASE_URL=http://localhost:8080

# --- LiteLLM provider (--provider litellm) ---
# litellm reads provider-specific env vars based on the --model prefix.
# OpenAI-compatible local endpoint example:
# OPENAI_API_KEY=sk-...
# Then run with: --provider litellm --model openai/<name> --api-base http://localhost:8000/v1
